  "familyNotes": {
    "Cape of Accomplishment": [
      "This requested skillcape expansion contains all 24 individual skills including Sailing. Quest point, music, achievement diary, and max capes belong to the wider Wiki category but are intentionally not silently substituted into this skill-only expansion.",
      "All trimmed skillcapes share basic equipment bonuses and precede the untrimmed group because of +4 Prayer. Ordering within each group is stable membership order, not a ranking of individual cape perks.",
      "Apply itemUpdates as well as items: existing trimmed aliases otherwise keep untrimmed IDs under the same option."
    ],
    "Rada's blessing": [
      "Tier order is 4, 3, 2, 1. Tier 4 provides +2 Prayer, tiers 3 and 2 +1, tier 1 zero; all are nonstackable AMMO-slot blessings, not fired ammunition.",
      "Tier 3 and tier 2 have the same equipment bonus; their diary utility differs."
    ],
    "Blessed d'hide boots": [
      "The six gods have identical equipment bonuses in this slot. Alphabetical god order is stable membership order, not a combat ranking.",
      "Do not replace a specifically required god-protection item with an arbitrary family member; god affiliation is not equivalent."
    ],
    "Blessed d'hide coif": [
      "The six gods have identical equipment bonuses in this slot. Alphabetical god order is stable membership order, not a combat ranking.",
      "Do not replace a specifically required god-protection item with an arbitrary family member; god affiliation is not equivalent."
    ],
    "Blessed d'hide shield": [
      "The six gods have identical equipment bonuses in this slot. Alphabetical god order is stable membership order, not a combat ranking.",
      "Do not replace a specifically required god-protection item with an arbitrary family member; god affiliation is not equivalent."
    ],
    "God book": [
      "Membership contains only the six completed books; damaged and incomplete books do not grant the same attack/defence bonuses.",
      "No global best-first order is supplied in optionFamilies. Proposed style orders are authoring inferences from the pinned bonuses, not a Wiki ranking.",
      "Magic: Darkness +10 Magic accuracy, Unholy +8, Balance +4, remaining books 0. Ranged: Law +10 Ranged accuracy, Unholy +8, Balance +4, remaining books 0.",
      "Melee: War gives +2 Strength while Unholy gives +8 melee accuracy. Their best choice depends on target defence and max-hit breakpoints. The suggested War-then-Unholy order is a strength-priority convention, not a universal comparison.",
      "Defensive: Holy +8 all defence, Balance +4 all defence, remaining books 0. All six completed books give +5 Prayer.",
      "God allegiance remains relevant to explicit god-protection constraints."
    ],
    "Broodoo shield": [
      "All three colours have the same equipment bonuses. Their passive effect drains different opponent combat stats; family equivalence applies to equipment bonuses only.",
      "Every concrete colour record includes all eleven raw-Wiki item IDs, including zero charges. Do not globally reject uncharged shields as unusable."
    ]
